<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained executable: the .NET runtime, WPF, the native renderer DLL, the dummy body and the
  name lists are all inside LBAAssembler.exe. Run: dotnet publish -p:PublishProfile=SingleFile
  (build the static renderer DLL first; see README).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>release\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- the time it was built, as its version (yyyy.M.d.HHmm, as LBRA's): the updater (EditorUpdater) only ever takes a newer one; -p:Version= overrides it -->
    <Version Condition="'$(Version)' == '' Or '$(Version)' == '1.0.0'">$([System.DateTime]::Now.ToString('yyyy.M.d.HHmm'))</Version>
  </PropertyGroup>
</Project>
